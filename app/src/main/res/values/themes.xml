<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The app is Compose-only: this theme exists to give the window the right background
      before the first frame (no action bar, edge-to-edge on API < 35).
    -->
    <style name="Theme.KsWallet" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ks_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
