<?xml version="1.0" encoding="utf-8"?><!--
  Same policy as backup_rules.xml: the database travels with the user (cloud backup and
  device-to-device transfer), the re-creatable preferences do not.
-->
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="database"
            path="kswallet.db" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="database"
            path="kswallet.db" />
    </device-transfer>
</data-extraction-rules>
