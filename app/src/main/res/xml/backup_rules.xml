<?xml version="1.0" encoding="utf-8"?><!--
  The ledger is the user's data, so the database is what gets backed up.
  Writing an <include> element at all means "nothing else is included": the DataStore
  preferences (theme mode, base currency) are recreated from defaults on a new device, so
  they are deliberately left out instead of being listed as an exclusion.
-->
<full-backup-content>
    <include
        domain="database"
        path="kswallet.db" />
</full-backup-content>
